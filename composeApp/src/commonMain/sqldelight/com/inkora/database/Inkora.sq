CREATE TABLE documents (
    id TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL,
    title TEXT NOT NULL,
    folder_id TEXT,
    created_at INTEGER NOT NULL,
    modified_at INTEGER NOT NULL,
    page_count INTEGER NOT NULL DEFAULT 0,
    is_favorite INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    is_trashed INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    thumbnail_path TEXT,
    source_file_name TEXT,
    managed_file_path TEXT,
    sync_status TEXT NOT NULL DEFAULT 'LOCAL_ONLY',
    metadata_json TEXT NOT NULL DEFAULT '{}'
);

CREATE INDEX documents_modified_at_index ON documents(modified_at);
CREATE INDEX documents_folder_id_index ON documents(folder_id);
CREATE INDEX documents_title_index ON documents(title COLLATE NOCASE);

CREATE TABLE folders (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    parent_id TEXT,
    created_at INTEGER NOT NULL,
    modified_at INTEGER NOT NULL,
    is_favorite INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    is_trashed INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    FOREIGN KEY (parent_id) REFERENCES folders(id) ON DELETE SET NULL
);

CREATE INDEX folders_parent_id_index ON folders(parent_id);

CREATE TABLE pages (
    id TEXT NOT NULL PRIMARY KEY,
    document_id TEXT NOT NULL,
    page_index INTEGER NOT NULL,
    title TEXT,
    template TEXT NOT NULL DEFAULT 'BLANK',
    paper_spec_json TEXT NOT NULL DEFAULT '{}',
    stroke_blob BLOB,
    created_at INTEGER NOT NULL,
    modified_at INTEGER NOT NULL,
    FOREIGN KEY (document_id) REFERENCES documents(id) ON DELETE CASCADE
);

CREATE UNIQUE INDEX pages_document_index ON pages(document_id, page_index);

CREATE TABLE annotations (
    id TEXT NOT NULL PRIMARY KEY,
    page_id TEXT NOT NULL,
    type TEXT NOT NULL,
    payload TEXT NOT NULL,
    bounds_left REAL NOT NULL,
    bounds_top REAL NOT NULL,
    bounds_right REAL NOT NULL,
    bounds_bottom REAL NOT NULL,
    created_at INTEGER NOT NULL,
    modified_at INTEGER NOT NULL,
    FOREIGN KEY (page_id) REFERENCES pages(id) ON DELETE CASCADE
);

CREATE INDEX annotations_page_id_index ON annotations(page_id);

CREATE TABLE bookmarks (
    id TEXT NOT NULL PRIMARY KEY,
    document_id TEXT NOT NULL,
    page_index INTEGER NOT NULL,
    title TEXT,
    note TEXT,
    created_at INTEGER NOT NULL,
    FOREIGN KEY (document_id) REFERENCES documents(id) ON DELETE CASCADE
);

CREATE TABLE recents (
    document_id TEXT NOT NULL PRIMARY KEY,
    opened_at INTEGER NOT NULL,
    FOREIGN KEY (document_id) REFERENCES documents(id) ON DELETE CASCADE
);

CREATE TABLE settings (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL,
    modified_at INTEGER NOT NULL
);

CREATE TABLE session_state (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    state_json TEXT NOT NULL,
    modified_at INTEGER NOT NULL
);

CREATE TABLE trash_metadata (
    document_id TEXT NOT NULL PRIMARY KEY,
    deleted_at INTEGER NOT NULL,
    original_folder_id TEXT,
    purge_after INTEGER,
    FOREIGN KEY (document_id) REFERENCES documents(id) ON DELETE CASCADE
);

selectDocuments:
SELECT * FROM documents WHERE is_trashed = 0 ORDER BY modified_at DESC;

selectAllDocuments:
SELECT * FROM documents ORDER BY modified_at DESC;

selectFolders:
SELECT * FROM folders WHERE is_trashed = 0 ORDER BY name COLLATE NOCASE;

selectAllFolders:
SELECT * FROM folders ORDER BY name COLLATE NOCASE;

searchDocuments:
SELECT * FROM documents WHERE is_trashed = 0 AND title LIKE '%' || :query || '%' COLLATE NOCASE ORDER BY title COLLATE NOCASE;

selectDocumentById:
SELECT * FROM documents WHERE id = :id;

insertDocument:
INSERT INTO documents(
    id, type, title, folder_id, created_at, modified_at, page_count,
    is_favorite, is_trashed, thumbnail_path, source_file_name,
    managed_file_path, sync_status, metadata_json
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateDocument:
UPDATE documents SET
    type = :type, title = :title, folder_id = :folder_id, created_at = :created_at, modified_at = :modified_at, page_count = :page_count,
    is_favorite = :is_favorite, is_trashed = :is_trashed, thumbnail_path = :thumbnail_path, source_file_name = :source_file_name,
    managed_file_path = :managed_file_path, sync_status = :sync_status, metadata_json = :metadata_json
WHERE id = :id;

insertFolder:
INSERT INTO folders(id, name, parent_id, created_at, modified_at, is_favorite, is_trashed)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateFolder:
UPDATE folders SET
    name = :name, parent_id = :parent_id, created_at = :created_at, modified_at = :modified_at, is_favorite = :is_favorite, is_trashed = :is_trashed
WHERE id = :id;

updateDocumentFolder:
UPDATE documents SET folder_id = ? WHERE id = ?;

updateDocumentFavorite:
UPDATE documents SET is_favorite = ? WHERE id = ?;

updateDocumentSummary:
UPDATE documents SET folder_id = ?, modified_at = ?, is_favorite = ?, is_trashed = ? WHERE id = ?;

moveDocumentToTrash:
UPDATE documents SET is_trashed = 1 WHERE id = ?;

restoreDocument:
UPDATE documents SET is_trashed = 0 WHERE id = ?;

deleteDocument:
DELETE FROM documents WHERE id = ?;

deleteFolder:
DELETE FROM folders WHERE id = ?;

insertTrashMetadata:
INSERT INTO trash_metadata(document_id, deleted_at, original_folder_id, purge_after)
VALUES (?, ?, ?, ?);

updateTrashMetadata:
UPDATE trash_metadata SET deleted_at = ?, original_folder_id = ?, purge_after = ? WHERE document_id = ?;

deleteTrashMetadata:
DELETE FROM trash_metadata WHERE document_id = ?;

selectTrash:
SELECT * FROM trash_metadata ORDER BY deleted_at DESC;
